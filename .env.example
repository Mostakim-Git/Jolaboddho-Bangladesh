# Server-only. Never prefix this key with VITE_.
GEMINI_API_KEY=
# gemini-2.5-flash is retired by Google on 2026-10-20; keep a current Flash model.
GEMINI_MODEL=gemini-3.8-flash
PORT=3001

# Optional: per-attempt timeout in milliseconds for a Gemini request (default 45000).
# GEMINI_TIMEOUT_MS=45000

# Optional additional trusted web origins (comma-separated). Native Android's
# https://localhost WebView origin is already allowed; this is NOT an API URL.
ALLOWED_ORIGINS=
# Public, non-secret backend origin. When empty, Android falls back to the
# deployed backend in shared/backend-url.js and the website stays same-origin.
# Can also be changed on-device in Service settings. Never place an API key in
# any VITE_ variable.
VITE_API_BASE_URL=
