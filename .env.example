# Server-only. Never prefix this key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=3001

# Optional additional trusted web origins (comma-separated). Native Android's
# https://localhost WebView origin is already allowed; this is NOT an API URL.
ALLOWED_ORIGINS=
# Public, non-secret backend origin baked into Android. Can also be configured
# in Service settings. Never place an API key in any VITE_ variable.
VITE_API_BASE_URL=
